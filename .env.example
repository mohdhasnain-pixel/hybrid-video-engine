# ---- Storage feature flag ---------------------------------------------------
# local = keep uploads/outputs on this computer (uses local disk space)
# s3    = keep them in an S3 bucket (only temporary work files stay local)
VE_STORAGE_BACKEND=local
VE_LOCAL_STORAGE_DIR=./data/storage

# Required when VE_STORAGE_BACKEND=s3 (credentials come from the normal AWS chain:
# AWS_PROFILE, AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY, SSO, instance role...)
VE_S3_BUCKET=
VE_S3_PREFIX=video-engine/
VE_S3_REGION=us-east-1
# VE_S3_ENDPOINT_URL=http://localhost:9000   # MinIO / LocalStack
VE_S3_PRESIGN_EXPIRY_SECONDS=3600

# ---- Processing -------------------------------------------------------------
VE_DEVICE=auto            # auto | mps | cpu
VE_MAX_UPLOAD_MB=4096
VE_KEEP_WORK_FILES=false  # keep decoder/encoder logs + partial files for debugging
